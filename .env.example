# MakyPay API Credentials
MAKYPAY_API_KEY=maky_v1_pub_YOUR_PUBLIC_KEY
MAKYPAY_API_SECRET=maky_v1_sec_YOUR_SECRET_KEY

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
